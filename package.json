{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform desktop shell for DeepSeek Harness (dsh) — a Codex Desktop alternative",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "dev": "pnpm --filter @dsh-desktop/desktop dev",
    "tauri": "pnpm --filter @dsh-desktop/desktop tauri"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  }
}
